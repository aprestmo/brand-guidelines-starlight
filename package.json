{
  "name": "brand-guidelines-starlight",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "start": "node ./dist/server/entry.mjs",
    "build": "pnpm run fetch-tokens && tinacms build --content=local -c \"astro build\"",
    "build:local": "pnpm run fetch-tokens && tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "fetch-tokens": "node scripts/fetch-tokens.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/starlight": "^0.41.7",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.2.4",
    "sharp": "^0.35.3",
    "tinacms": "^3.12.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.6.0",
    "@types/node": "^26.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}